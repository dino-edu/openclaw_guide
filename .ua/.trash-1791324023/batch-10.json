      "type": "document",
      "name": "9.4_event_idempotency.md",
      "filePath": "09_gateway_protocol/9.4_event_idempotency.md",
      "summary": "Examines event idempotency, sequence ordering, and eventual consistency guarantees across distributed agent networks. Explains handling duplicate, lost, or unknown states via idempotency keys, sequence gap detection for snapshot refresh, and session-level mutex locking.",
      "tags": [
        "idempotency",
        "event-ordering",
        "sequence-gap",
        "eventual-consistency",
        "documentation"
      ],
      "complexity": "moderate"
    },
