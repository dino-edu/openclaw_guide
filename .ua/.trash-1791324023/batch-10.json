      "type": "document",
      "name": "9.5_pairing_trust.md",
      "filePath": "09_gateway_protocol/9.5_pairing_trust.md",
      "summary": "Explains establishing local trust perimeters via device identity registration, nonce-based cryptographic challenge verification, and operator approval workflows. Distinguishes Control Plane device pairing from chat-level DM sender pairing, and outlines token rotation and emergency revocation mechanisms.",
      "tags": [
        "device-pairing",
        "trust-perimeter",
        "cryptographic-verification",
        "token-rotation",
        "documentation"
      ],
