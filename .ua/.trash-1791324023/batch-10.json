      "id": "document:09_gateway_protocol/9.3_ws_handshake.md",
      "type": "document",
      "name": "9.3_ws_handshake.md",
      "filePath": "09_gateway_protocol/9.3_ws_handshake.md",
      "summary": "Details the full lifecycle of persistent WebSocket connections, covering challenge-response authentication, device identity signatures, keepalive heartbeats, and exponential backoff reconnection. Clarifies the architectural distinction between transport-level connections and stateful sessions.",
      "tags": [
        "websocket",
        "handshake-protocol",
        "challenge-response",
        "heartbeat",
        "documentation"
      ],
      "complexity": "moderate"
    },
    {
